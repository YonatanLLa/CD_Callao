---
// Icono SVG inline (sin dependencias).
import { ICON_PATHS, type IconName } from "../lib/icons";

interface Props { name: IconName; size?: number; class?: string; strokeWidth?: number }
const { name, size = 20, class: cls = "", strokeWidth = 2 } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden="true"
  set:html={ICON_PATHS[name]}
/>
