---
import type { EChartsOption } from "echarts";
import Icon from "./Icon.astro";
import type { IconName } from "../lib/icons";

interface Props {
  id: string;
  title: string;
  subtitle?: string;
  option: EChartsOption;
  format?: "pct" | "pctc" | "num";
  /** Clases extra para el título (p. ej. estilo infografía). */
  titleClass?: string;
  height?: number;
  yearFilter?: boolean;
  note?: string;
  class?: string;
  /** Una opción por año ("" = todos) para gráficos que se recalculan con el filtro de año. */
  optionsByYear?: Record<string, EChartsOption>;
  /** Icono del título; por defecto se deduce del tipo de gráfico. */
  icon?: IconName;
}
const { id, title, subtitle, option, format = "num", height = 320, yearFilter = false, optionsByYear, note, class: cls = "", titleClass = "" } = Astro.props;
const firstSeries = Array.isArray(option.series) ? option.series[0] : option.series;
const tipo = (firstSeries as { type?: string } | undefined)?.type;
const icon: IconName = Astro.props.icon ?? (tipo === "pie" ? "pie" : tipo === "bar" ? "bars" : tipo === "heatmap" ? "table" : "chart");
---
<figure class={`card flex flex-col gap-3 p-4 sm:p-5 ${cls}`}>
  <header class="flex items-start justify-between gap-3">
    <div class="section-title min-w-0 items-start!">
      <span class="section-icon mt-px"><Icon name={icon} size={15} strokeWidth={2.2} /></span>
      <div class="min-w-0">
        <h2 class={titleClass}>{title}</h2>
        {subtitle && <p class="mt-0.5 text-[13px] leading-snug text-ink-2">{subtitle}</p>}
      </div>
    </div>
    <button
      type="button"
      class="btn-ghost shrink-0"
      data-download={id}
      data-filename={id}
      title="Descargar como PNG"
      aria-label={`Descargar gráfico "${title}" como PNG`}
    >
      <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10 3v9m0 0-3.5-3.5M10 12l3.5-3.5M4 14.5V16h12v-1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span class="hidden sm:inline">PNG</span>
    </button>
  </header>
  <div
    id={id}
    data-chart
    data-format={format}
    data-year-filter={yearFilter ? "" : undefined}
    data-option={JSON.stringify(option)}
    data-options-by-year={optionsByYear ? JSON.stringify(optionsByYear) : undefined}
    style={`height:${height}px`}
    class="w-full"
    role="img"
    aria-label={title}
  ></div>
  <slot />
  {note && <figcaption class="text-xs leading-snug text-muted">{note}</figcaption>}
</figure>

<script>
  import "../scripts/charts";
</script>
