---
import "../styles/global.css";
import { FUENTE } from "../lib/data";
import { CD_NOMBRE } from "../config/resumen";

interface Props { title: string; description?: string }
const { title, description } = Astro.props;

const nav = [
  { href: "/", label: "Resumen", icon: "M3 10.5 10 4l7 6.5V16a1 1 0 0 1-1 1h-3.5v-4h-5v4H4a1 1 0 0 1-1-1z" },
  { href: "/rotacion", label: "Rotación", icon: "M4 7h10l-3-3M16 13H6l3 3" },
  { href: "/ausentismo", label: "Ausentismo", icon: "M4 5h12v11H4zM4 8h12M8 3v3M12 3v3" },
  { href: "/headcount", label: "Headcount", icon: "M7 9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5zm6.5 0a2 2 0 1 0 0-4M2.5 16c.5-3 2.3-4.5 4.5-4.5s4 1.5 4.5 4.5m2-4.3c1.7.2 3.2 1.6 3.6 4.3" },
  { href: "/acciones", label: "Acciones", icon: "M4 5.5 5.5 7 8 4.5M10 6h6M4 11.5 5.5 13 8 10.5M10 12h6" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const current = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---
<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{`${title} · GKPI ${CD_NOMBRE}`}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem("tema"); } catch (e) {}
        if (t !== "light" && t !== "dark") t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = t;
        try { if (localStorage.getItem("sidebar") === "oculto") document.documentElement.dataset.sidebar = "oculto"; } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <div id="shell" class="lg:grid lg:grid-cols-[232px_1fr]">
      <!-- Sidebar -->
      <aside
        id="sidebar"
        class="fixed inset-y-0 left-0 z-40 w-[232px] -translate-x-full bg-sidebar text-white transition-transform duration-200 lg:sticky lg:top-0 lg:h-screen lg:translate-x-0"
        aria-label="Navegación principal"
      >
        <div class="flex h-16 items-center gap-3 border-b border-white/10 px-4">
          <img src="/favicon.svg" alt="" width="30" height="30" />
          <div class="sb-text leading-tight">
            <p class="text-sm font-extrabold tracking-wide text-white">GKPI</p>
            <p class="text-xs font-semibold text-brand-yellow">{CD_NOMBRE}</p>
          </div>
        </div>
        <nav class="flex flex-col gap-1 px-3 py-3">
          {nav.map((n) => (
            <a href={n.href} class="nav-link" title={n.label} aria-current={current(n.href) ? "page" : undefined}>
              <svg class="shrink-0" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={n.icon} /></svg>
              <span class="sb-text">{n.label}</span>
            </a>
          ))}
        </nav>
        <p class="sb-text absolute bottom-4 left-4 right-4 border-t border-white/10 pt-3 text-[11px] leading-snug text-white/50">
          Fuente: {FUENTE}
        </p>
      </aside>
      <div id="backdrop" class="fixed inset-0 z-30 hidden bg-black/30 lg:hidden"></div>

      <!-- Contenido -->
      <div class="min-w-0">
        <header class="sticky top-0 z-20 flex h-14 items-center gap-3 border-b border-line bg-surface/90 px-4 backdrop-blur sm:px-6">
          <button id="collapse-btn" type="button" class="btn-ghost hidden lg:inline-flex" aria-controls="sidebar" aria-expanded="true" aria-label="Contraer menú lateral" title="Contraer/expandir menú (Ctrl+B)">
            <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="14" height="12" rx="2" /><path d="M8 4v12" /></svg>
          </button>
          <span class="hidden h-6 w-1 rounded-full bg-brand-yellow lg:block" aria-hidden="true"></span>
          <button id="menu-btn" type="button" class="btn-ghost lg:hidden" aria-label="Abrir menú" aria-controls="sidebar" aria-expanded="false">
            <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" /></svg>
          </button>
          <div class="min-w-0 flex-1">
            <h1 class="truncate text-base font-extrabold tracking-tight text-brand-navy-ink">{title}</h1>
          </div>
          <button id="theme-btn" type="button" class="btn-ghost" aria-label="Cambiar tema claro/oscuro" title="Cambiar tema">
            <svg class="theme-sun" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="3.5" /><path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M4.3 15.7l1.4-1.4M14.3 5.7l1.4-1.4" /></svg>
            <svg class="theme-moon" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M16 12.5A6.5 6.5 0 0 1 7.5 4a6.5 6.5 0 1 0 8.5 8.5z" /></svg>
            <span class="hidden sm:inline theme-label"></span>
          </button>
        </header>
        <main class="mx-auto flex w-full max-w-[1600px] flex-col gap-5 px-4 py-5 sm:px-6 sm:py-6">
          <slot />
        </main>
      </div>
    </div>

    <style is:global>
      [data-theme="dark"] .theme-sun, [data-theme="light"] .theme-moon { display: none; }
      [data-theme="light"] .theme-label::after { content: "Oscuro"; }
      [data-theme="dark"] .theme-label::after { content: "Claro"; }
      @media (min-width: 1024px) {
        #shell { transition: grid-template-columns 200ms ease; }
        #sidebar { transition: width 200ms ease; overflow: hidden; }
        [data-sidebar="oculto"] #shell { grid-template-columns: 64px 1fr; }
        [data-sidebar="oculto"] #sidebar { width: 64px; }
        [data-sidebar="oculto"] #sidebar .sb-text { display: none; }
        [data-sidebar="oculto"] #sidebar .nav-link { justify-content: center; padding-left: 0; padding-right: 0; }
      }
    </style>

    <script>
      const root = document.documentElement;
      document.getElementById("theme-btn")?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("tema", next); } catch { /* almacenamiento no disponible */ }
        document.dispatchEvent(new CustomEvent("themechange"));
      });

      const sidebar = document.getElementById("sidebar");
      const backdrop = document.getElementById("backdrop");
      const menuBtn = document.getElementById("menu-btn");
      const setMenu = (open: boolean) => {
        sidebar?.classList.toggle("-translate-x-full", !open);
        backdrop?.classList.toggle("hidden", !open);
        menuBtn?.setAttribute("aria-expanded", String(open));
      };
      menuBtn?.addEventListener("click", () => setMenu(sidebar?.classList.contains("-translate-x-full") ?? false));
      backdrop?.addEventListener("click", () => setMenu(false));
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") setMenu(false); });

      // Ocultar/mostrar la barra lateral en escritorio (se recuerda entre páginas).
      const collapseBtn = document.getElementById("collapse-btn");
      const syncCollapse = () => {
        const oculto = root.dataset.sidebar === "oculto";
        collapseBtn?.setAttribute("aria-expanded", String(!oculto));
        collapseBtn?.setAttribute("aria-label", oculto ? "Expandir menú lateral" : "Contraer menú lateral");
      };
      const toggleSidebar = () => {
        if (root.dataset.sidebar === "oculto") delete root.dataset.sidebar;
        else root.dataset.sidebar = "oculto";
        try { localStorage.setItem("sidebar", root.dataset.sidebar ?? "visible"); } catch { /* sin almacenamiento */ }
        syncCollapse();
        // Los gráficos se ajustan al nuevo ancho cuando termina la transición.
        setTimeout(() => window.dispatchEvent(new Event("resize")), 220);
      };
      collapseBtn?.addEventListener("click", toggleSidebar);
      document.addEventListener("keydown", (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "b" && window.innerWidth >= 1024) { e.preventDefault(); toggleSidebar(); }
      });
      syncCollapse();
    </script>
  </body>
</html>
